  {
   "@id": "https://micheldumontier.github.io/bh-meet/projects.jsonld#rdf-extraction-engine",
   "@type": "ResearchProject",
   "name": "RDF Data Extraction and Engine Implementation",
   "identifier": "rdf-extraction-engine",
