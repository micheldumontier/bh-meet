     "@type": "PropertyValue",
     "name": "aim",
     "value": "Encode single-cell transcriptome profiles as olfactory stimuli"
    },
    {
     "@type": "PropertyValue",
     "name": "aim",
     "value": "Train the in-silico fly brain on known cell types"
    },
    {
     "@type": "PropertyValue",
     "name": "aim",
     "value": "Test whether novelty shows up as excitation"
    }
   ]
  },
