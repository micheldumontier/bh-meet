     "member": {
      "@type": "Person",
      "name": "Keitaro"
     }
    }
   ],
   "additionalProperty": [
    {
     "@type": "PropertyValue",
     "name": "aim",
     "value": "Show with open data that readiness to return to sport is a psychological state as much as a mechanical one"
    },
    {
     "@type": "PropertyValue",
     "name": "aim",
     "value": "Test whether axial stability under fatigue tracks psychological readiness as closely as knee function does"
    }
   ]
  },
