   "@id": "https://micheldumontier.github.io/bh-meet/projects.jsonld#patient-trajectories",
   "@type": "ResearchProject",
   "name": "Patient Trajectory Matching over Temporal Knowledge Graphs",
   "identifier": "patient-trajectories",
   "description": "Clinical trajectories are how diagnoses, treatments, procedures and measurements unfold over time. An open trajectory query engine would find patients whose histories satisfy a temporal pattern, then widen the search through explicitly permitted semantic and temporal relaxations, showing the evidence behind every result.",
