  {
   "@id": "https://micheldumontier.github.io/bh-meet/projects.jsonld#biosample-curation",
   "@type": "ResearchProject",
   "name": "LLM-assisted data curation of the BioSample database",
   "identifier": "biosample-curation",
   "description": "DBCLS's pipeline uses LLMs to map freely-written biological sample metadata to ontology terms, and has already mapped about 4 million BioSample records.",
