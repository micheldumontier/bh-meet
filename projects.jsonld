  {
   "@id": "https://micheldumontier.github.io/bh-meet/projects.jsonld#fruit-fly-cell-types",
   "@type": "ResearchProject",
   "name": "Let fruit fly do novel cell type detection",
   "identifier": "fruit-fly-cell-types",
   "description": "The whole-brain fly connectome has been published as MaleCNS v1.0. Flies lose interest in a smell after repeated exposure — so turn single-cell transcriptome profiles into smells, let a simulated fly experience as many as possible, and see whether it stays calm for a known cell type and reacts to a novel one.",
   "keywords": [
    "Others"
   ],
   "isPartOf": "https://micheldumontier.github.io/bh-meet/dataset.jsonld#dataset",
   "member": [
