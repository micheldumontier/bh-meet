  {
   "@id": "https://micheldumontier.github.io/bh-meet/projects.jsonld#fatigue-and-fear",
   "@type": "ResearchProject",
   "name": "When Fatigue Reveals Fear",
   "identifier": "fatigue-and-fear",
   "description": "When landing on both feet, do people considered recovered still shift away from the injured side, does fatigue amplify that shift and destabilise the trunk and pelvis, and does fatigue make fear of movement legible in the body? The hypothesis: conscious control masks psychological state at rest, and fatigue removes the mask.",
   "keywords": [
    "Others"
   ],
   "isPartOf": "https://micheldumontier.github.io/bh-meet/dataset.jsonld#dataset",
   "member": [
    {
     "@type": "Role",
