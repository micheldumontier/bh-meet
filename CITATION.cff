    given-names: Michel
    affiliation: Maastricht University
repository-code: https://github.com/micheldumontier/bh-meet
url: https://micheldumontier.github.io/bh-meet/
license: CC0-1.0
date-released: '2026-09-13'
keywords:
  - BioHackathon
  - bioinformatics
  - FAIR data
  - participant directory
  - JSON-LD
