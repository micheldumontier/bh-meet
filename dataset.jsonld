{
 "@context": {
  "@vocab": "https://schema.org/",
  "schema": "https://schema.org/",
  "dcat": "http://www.w3.org/ns/dcat#",
  "dcterms": "http://purl.org/dc/terms/",
  "prov": "http://www.w3.org/ns/prov#",
  "license": {
   "@id": "schema:license",
   "@type": "@id"
  },
  "wasDerivedFrom": {
   "@id": "prov:wasDerivedFrom",
   "@type": "@id"
  },
  "isBasedOn": {
   "@id": "schema:isBasedOn",
   "@type": "@id"
  },
  "codeRepository": {
   "@id": "schema:codeRepository",
   "@type": "@id"
  }
 },
 "@id": "https://micheldumontier.github.io/bh-meet/dataset.jsonld#dataset",
 "@type": [
  "Dataset",
  "dcat:Dataset"
 ],
 "name": "BH26 Collaboration Index",
 "alternateName": "bh-meet",
 "description": "Self-introductions of BioHackathon 2026 participants in Matsuyama, indexed by research topic, programming language and skill. Curated by hand from the event self-introduction slide deck.",
 "url": "https://micheldumontier.github.io/bh-meet/",
 "license": "http://creativecommons.org/publicdomain/zero/1.0/",
 "creator": {
  "@type": "Person",
  "name": "Michel Dumontier"
 },
 "dateModified": "2026-09-13",
 "version": "2026-09-13",
 "inLanguage": "en",
 "keywords": [
  "Biodiversity",
  "Clinical",
  "Cloud/HPC",
  "Databases",
  "FAIR/Standards",
  "Genomics",
  "Glycomics",
  "Knowledge graphs",
  "LLM/AI",
  "Machine learning",
  "Metabolomics",
  "Microbiology",
  "Ontologies",
  "Pangenome",
  "Plants/Agriculture",
  "Population genetics",
  "Proteomics",
  "RDF/SPARQL",
  "Rare disease",
  "Structural biology",
  "Text mining",
  "Variants",
  "Visualisation",
  "Web dev",
  "Workflows"
 ],
 "isBasedOn": "https://docs.google.com/presentation/d/1UWasNu6Wa_zCRhuWErF0cu2-uHpxwVBOU_6bNarQe1c/edit",
 "wasDerivedFrom": "https://docs.google.com/presentation/d/1UWasNu6Wa_zCRhuWErF0cu2-uHpxwVBOU_6bNarQe1c/edit",
 "codeRepository": "https://github.com/micheldumontier/bh-meet",
 "measurementTechnique": "Extracted from the slide deck with scripts/extract-deck.py, then curated by hand.",
 "variableMeasured": [
  "name",
  "affiliation",
  "country",
  "programming languages",
  "research interests",
  "skills",
  "personal message",
  "topic tags"
 ],
 "distribution": [
  {
   "@type": "DataDownload",
   "name": "Participants as JSON-LD",
   "encodingFormat": "application/ld+json",
   "contentUrl": "https://micheldumontier.github.io/bh-meet/people.jsonld"
  },
  {
   "@type": "DataDownload",
   "name": "Topic vocabulary as SKOS",
   "encodingFormat": "application/ld+json",
   "contentUrl": "https://micheldumontier.github.io/bh-meet/topics.jsonld"
  },
  {
   "@type": "DataDownload",
   "name": "Participants as the browser loads them",
   "encodingFormat": "application/javascript",
   "contentUrl": "https://micheldumontier.github.io/bh-meet/data.js"
  },
  {
   "@type": "DataDownload",
   "name": "Portrait manifest",
   "encodingFormat": "application/json",
   "contentUrl": "https://micheldumontier.github.io/bh-meet/photos.json"
  }
 ]
}
