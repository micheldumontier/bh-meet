  {
   "@id": "https://micheldumontier.github.io/bh-meet/people.jsonld#michel-dumontier",
   "@type": "Person",
   "name": "Michel Dumontier",
   "identifier": "michel-dumontier",
   "description": "Biochemist by training, data scientist by practice. FAIR data, open science, reproducibility. Ontologies (SIO, SULO, OntoExplorer, RustDL), RDF linked data (Bio2RDF), mapping (ShExMap), metadata (HCLS dataset description, KG metadata). Neurosymbolic AI: biomedical data embedding from molecule to patient, prediction and explainable AI, drug discovery and personalized medicine. Plans: federated agentic research systems — how can researchers with AI meaningfully collaborate? — and temporal knowledge graphs extending SULO with provable temporal transforms.",
   "affiliation": {
